#!/usr/bin/env bash
# Grid'5000 OAR batch job, on one CPU node with much memory (for example dahu in Grenoble):
# read the metadata dump, keep the capped candidates, write the sample in uniform order
# (ADR 0011), and put the state on the private hub repository.
#
#   oarsub -q default -l "host=1,walltime=1:00:00" -p "gpu_count=0 AND cluster='dahu'" \
#       "$HOME/inat-landscape-filtering/scripts/g5k/ingest.oar 1000"
#
# The dump passes take more than 1 hour: extend the job by 1 hour in its last 10 minutes
# (`oarwalltime JOB_ID +1:00`), as the usage policy permits.
set -euo pipefail

REPO_DIR="${REPO_DIR:-$HOME/inat-landscape-filtering}"
CAP="${1:?usage: ingest.oar CAP|sample}"
BASE="/tmp/inat-$USER-ingest"
# A copy on the node /tmp: a `git pull` on the NFS /home does not stop the job.
if [ "$0" != "$BASE/ingest.oar" ]; then
    mkdir -p "$BASE" && cp "$0" "$BASE/ingest.oar"
    exec bash "$BASE/ingest.oar" "$@"
fi
WORK="$BASE/work"
export UV_CACHE_DIR="$BASE/uv-cache" UV_PYTHON_INSTALL_DIR="$BASE/python" UV_LINK_MODE=copy
export UV_PROJECT_ENVIRONMENT="$BASE/venv" HF_HOME="$BASE/hf" HF_HUB_DISABLE_PROGRESS_BARS=1
HF_TOKEN="$(cat "$HOME/.hf_token")"
export HF_TOKEN
export PATH="$BASE/bin:$HOME/.local/bin:$PATH"
mkdir -p "$WORK"

command -v uv >/dev/null || curl -LsSf https://astral.sh/uv/0.11.32/install.sh \
    | env UV_INSTALL_DIR="$BASE/bin" UV_NO_MODIFY_PATH=1 sh
cd "$REPO_DIR"
uv sync --locked -q
run() { uv run --no-sync inat-landscape --workdir "$WORK" "$@"; }

# The dump: one 37 GB gzipped tar. One HTTP stream gives about 40 MB/s, and Python gunzip
# about 60 MB/s, for each of the two passes. So the job downloads it once with parallel
# ranges, and decompresses it once with pigz into a plain tar on the node /tmp (about 90 GB).
DUMP="$BASE/dump.tar"
fetch_dump() {
    local url size parts=32 chunk
    url="$(uv run --no-sync python -c 'from inat_landscape.adapters.inat_dump import SNAPSHOT_URL as u; print(u)')"
    size="$(curl -sfI "$url" | tr -d '\r' | awk 'tolower($1) == "content-length:" {print $2}')"
    chunk=$(( (size + parts - 1) / parts ))
    seq 0 $((parts - 1)) | xargs -P 16 -I{} sh -c \
        "curl -sf --retry 20 --retry-delay 5 -r \$(({} * $chunk))-\$(({} * $chunk + $chunk - 1)) '$url' -o '$BASE/part.{}'"
    [ "$(stat -c %s "$BASE"/part.* | paste -sd+ | bc)" -eq "$size" ] \
        || { echo "dump download is incomplete" >&2; exit 1; }
    for i in $(seq 0 $((parts - 1))); do cat "$BASE/part.$i"; rm "$BASE/part.$i"; done | pigz -dc > "$DUMP"
    echo "$url" > "$BASE/source"
}
dump() { echo --source "$(cat "$BASE/source")" --dump-file "$DUMP"; }

if [ "$CAP" = sample ]; then
    # Only the sample again, from the candidates of the state (for example with a new order).
    run state pull --only ingest/manifest.json,ingest/candidates.parquet,failures.parquet
else
    # The failure file and the dump index of an earlier try, if any (the index records its
    # parameters and its taxa scope, so a stale index is not used).
    run state pull --only failures.parquet,ingest/taxa.parquet,ingest/taxa.json,ingest/index.json,ingest/selected.parquet,ingest/cell_counts.parquet || true
    fetch_dump
    run measure --cap "$CAP" --caps "10,50,100,300,1000" $(dump)
    # The embed work list, from the index: the GPU jobs can start now, before the details pass.
    run worklist --cap "$CAP" $(dump)
    run state push
    run ingest --cap "$CAP" $(dump)
    rm -f "$DUMP"
fi
run sample
run status
run state push
