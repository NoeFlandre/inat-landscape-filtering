#!/usr/bin/env bash
# Grid'5000 OAR batch job: embed the share of one worker slot I/N on one GPU.
#
# Submit with scripts/g5k/submit.sh (one slot) or scripts/g5k/submit_all.sh (all sites).
# The job resumes: the embeddings on the hub are the record of done work. While photos are
# left and the previous job made progress, each job queues the next job of its slot, with
# the same oarsub options. So one submission runs the slot to the end.
set -euo pipefail
START="${START:-$(date +%s)}"  # the job start: the walltime is 1 hour from here
export START

REPO_DIR="${REPO_DIR:-$HOME/inat-landscape-filtering}"
WORKER="${1:?usage: embed.oar I/N|I:J/N}"  # the slots of this chain, out of the worker count
SLOT="$(sed "s#:#-#; s#/#-of-#" <<< "$WORKER")"  # 3/9 -> 3-of-9, 3:6/9 -> 3-6-of-9
BASE="/tmp/inat-$USER-$SLOT"
# Bash reads a script while it runs it. A `git pull` on the NFS /home replaces this file and
# stops the job ("Stale file handle"). So the job runs a copy on the node /tmp.
if [ "$0" != "$BASE/embed.oar" ]; then
    mkdir -p "$BASE" && cp "$0" "$BASE/embed.oar"
    exec bash "$BASE/embed.oar" "$@"
fi
# /home (25 GB quota) keeps only the repository and a small folder for each slot: its oarsub
# options, its failure file and its last count of photos left.
KEEP="$HOME/.inat-landscape/$SLOT"
# Everything else is on the node-local /tmp, deleted after the job: the Python environment,
# the caches and the work directory. Each slot has its own folder, as jobs can share a node.
WORK="$BASE/work"
FAILS="failures-$SLOT.parquet"
# One worker (0/1, the retry pass) uses the shared failure file of the state.
[ "${WORKER#*/}" = 1 ] && FAILS="failures.parquet"
export UV_CACHE_DIR="$BASE/uv-cache" UV_PYTHON_INSTALL_DIR="$BASE/python" UV_LINK_MODE=copy
export UV_PROJECT_ENVIRONMENT="$BASE/venv" HF_HOME="$BASE/hf" HF_HUB_DISABLE_PROGRESS_BARS=1
# The token file is made once on each site (mode 600). It is never in the repository.
HF_TOKEN="$(cat "$HOME/.hf_token")"
export HF_TOKEN
export PATH="$BASE/bin:$HOME/.local/bin:$PATH"
mkdir -p "$KEEP" "$WORK"

command -v uv >/dev/null || curl -LsSf https://astral.sh/uv/0.11.32/install.sh \
    | env UV_INSTALL_DIR="$BASE/bin" UV_NO_MODIFY_PATH=1 sh
cd "$REPO_DIR"
uv sync --locked --no-default-groups --group cu126 -q
run() { uv run --no-sync inat-landscape --workdir "$WORK" "$@"; }

nvidia-smi --query-gpu=name,memory.total,compute_cap --format=csv,noheader
# torch.compile (Triton) needs compute capability 7.0 or more: Pascal GPUs run without it.
compile=()
cap="$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader | head -1)"
[ "${cap%%.*}" -ge 7 ] || compile=(--no-compile)
run state pull --only sample-ids.parquet,failures.parquet  # about 1 GB, not the full sample
# Keep the failure file of the slot on /home, so the next job does not try the same photos.
[ -f "$KEEP/$FAILS" ] && cp "$KEEP/$FAILS" "$WORK/$FAILS"
save_failures() { [ -f "$WORK/$FAILS" ] && cp "$WORK/$FAILS" "$KEEP/$FAILS" || true; }
trap save_failures EXIT

todo="$(run embed --worker "$WORKER" --plan | sed -n 's/^todo=//p')"
last="$(cat "$KEEP/todo" 2>/dev/null || echo)"
echo "worker $WORKER: ${todo:-?} photos left (previous job: ${last:-none})"
echo "${todo:-0}" > "$KEEP/todo"
if [ "${todo:-0}" -eq 0 ]; then
    touch "$KEEP/done"  # submit_all.sh does not start this slot again
    exit 0
fi
if [ -n "$last" ] && [ "$todo" -ge "$last" ]; then
    echo "no progress since the previous job: the chain stops" >&2
    exit 1
fi
# Shards of 200,000 photos (about 300 MB, 10 to 20 minutes of work): few commits on the hub.
# Stop 6 minutes before the walltime, after a batch, so the last shard is saved.
left=$((START + 3600 - 360 - $(date +%s)))
# One process downloads about 70 photos per second: use the cores of the job (2 for the
# model and the decode threads).
procs=$(( $(nproc) - 2 )); [ "$procs" -ge 1 ] || procs=1; [ "$procs" -le 12 ] || procs=12
# An error (for example a refused upload) must not end the chain: the next job continues,
# and it stops by itself when a job makes no progress.
run embed --worker "$WORKER" --chunk 200000 --batch-size 256 --concurrency 64 --download-batch 4096 \
    --fetch-processes "$procs" --max-seconds "$left" "${compile[@]}" \
    || echo "embed failed (exit $?): the next job tries again" >&2
save_failures
# The retry pass puts the new failure file in the state, for `score`, `publish` and `--plan`.
if [ "${WORKER#*/}" = 1 ]; then
    run state push
    exit 0
fi
# Queue the next 1-hour job of this slot now, a few minutes before the end of this job. It
# starts when this job ends, less than 10 minutes after its submission, so it does not count
# in the daytime quota (usage policy). It stops at once when no photo is left.
# The nodes have no OAR commands: the job submits through the frontend of its site.
mapfile -t options < "$KEEP/oarsub.options"
next=(oarsub -a "$OAR_JOB_ID" -n "inat-embed-$SLOT" "${options[@]}" -l "gpu=1,walltime=1:00:00"
    -O "$HOME/.inat-landscape/logs/%jobid%.out" -E "$HOME/.inat-landscape/logs/%jobid%.err"
    "$REPO_DIR/scripts/g5k/embed.oar $WORKER")
ssh -n -o BatchMode=yes -o StrictHostKeyChecking=accept-new "frontend.$(hostname -d)" "${next[*]@Q}" \
    || echo "could not queue the next job: scripts/g5k/submit_all.sh starts the slot again" >&2
